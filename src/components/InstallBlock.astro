---
import { withBase } from '../utils/base-path';

const commands = [
  { label: 'JavaScript', command: 'npm install @synonymdev/pubky' },
  { label: 'React Native', command: 'npm install @synonymdev/react-native-pubky' },
  { label: 'Rust', command: 'cargo add pubky' },
];

// The experiment intentionally points agents to the maintained production docs.
const aiPrompt = `Help me build an app with Pubky: public-key identity and user-owned data.

First ask what I want to build and which language or framework I use.

Read https://pubky.org/llms-small.txt, then fetch only the relevant .md pages. Start with https://pubky.org/explore/pubky-protocol/getting-started.md when appropriate.

Before writing code, check my installed SDK version against its maintained upstream documentation. Cite the sources you use and flag anything you cannot verify.`;

const installSectionBg = `--install-section-bg: url("${withBase('/images/bg-square.png')}")`;
---

<section class="install-section not-content" style={installSectionBg} aria-labelledby="landing-title">
  <div class="install-block">
    <div class="install-left">
      <p class="landing-eyebrow">The Pubky knowledge base</p>
      <h1 id="landing-title" class="install-heading">Build for<br />user sovereignty.</h1>
      <p class="install-tagline">Public-key identity. User-owned data.<br />An open protocol for apps that put people in control.</p>
      <div class="install-actions">
        <a href={withBase('/explore/pubky-protocol/getting-started/')} class="landing-button landing-button-primary">
          Start building
          <img class="landing-arrow" src={withBase('/images/icons/arrow-right.svg')} width="20" height="20" alt="" aria-hidden="true" />
        </a>
        <a href={withBase('/overview/')} class="landing-button landing-button-secondary">Explore the docs</a>
      </div>
      <a href="https://github.com/pubky" class="landing-source-link" target="_blank" rel="noopener noreferrer" aria-label="Explore Pubky on GitHub (opens in new tab)">
        <img src={withBase('/images/icons/github.svg')} width="20" height="20" alt="" aria-hidden="true" />
        Open source. Yours to build on.
        <img class="landing-external-arrow" src={withBase('/images/icons/arrow-right.svg')} width="16" height="16" alt="" aria-hidden="true" />
      </a>
    </div>

    <div class="install-right">
      <div class="starter-panel">
        <div class="starter-panel-heading">
          <span class="starter-mark" aria-hidden="true"><img src={withBase('/images/icons/code-xml.svg')} width="20" height="20" alt="" /></span>
          <div>
            <p class="landing-eyebrow">Bring your own agent</p>
            <h2>Give your AI a place to start.</h2>
          </div>
        </div>
        <p class="starter-description">Paste this into your coding assistant to start with Pubky’s docs.</p>
        <pre class="starter-prompt" id="pubky-starter-prompt" tabindex="0" aria-label="Selectable Pubky starter prompt">{aiPrompt}</pre>
        <div class="starter-actions">
          <button type="button" class="landing-button starter-copy" data-copy-text={aiPrompt} data-copy-kind="prompt" data-copy-status="starter-copy-status" hidden>
            <img src={withBase('/images/icons/line-copy.svg')} width="16" height="16" alt="" aria-hidden="true" />
            <span data-copy-label>Copy starter prompt</span>
          </button>
          <a href="#build-with-ai" class="starter-tools-link">More AI tools <span aria-hidden="true">↓</span></a>
        </div>
        <p id="starter-copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
        <noscript><p class="copy-fallback">Select the prompt above and copy it into your assistant.</p></noscript>
      </div>
    </div>

    <details class="sdk-install">
      <summary>
        <span class="sdk-summary-title">Install an SDK</span>
        <span class="sdk-summary-languages">JavaScript · React Native · Rust</span>
        <span class="sdk-expand" aria-hidden="true">+</span>
      </summary>
      <div class="sdk-commands">
        {commands.map((command) => (
          <div class="sdk-command-row">
            <span class="sdk-language">{command.label}</span>
            <code>{command.command}</code>
            <button type="button" class="sdk-copy" data-copy-text={command.command} data-copy-kind="command" data-copy-status="sdk-copy-status" aria-label={`Copy ${command.label} install command`} hidden>
              <img src={withBase('/images/icons/line-copy.svg')} width="16" height="16" alt="" aria-hidden="true" />
              <span data-copy-label>Copy</span>
            </button>
          </div>
        ))}
        <p id="sdk-copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </details>
  </div>
</section>

<script>
  function enhanceLandingCopy() {
    document.querySelectorAll<HTMLButtonElement>('.install-section [data-copy-text]').forEach((button) => {
      if (button.dataset.copyReady) return;
      button.dataset.copyReady = 'true';
      button.hidden = false;

      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const originalLabel = label?.textContent ?? 'Copy';
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener('click', async () => {
        const status = document.getElementById(button.dataset.copyStatus ?? '');
        const text = button.dataset.copyText;
        if (!status || !text) return;

        clearTimeout(resetTimer);
        status.textContent = '';
        if (label) label.textContent = originalLabel;
        button.disabled = true;

        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied';
          status.textContent = button.dataset.copyKind === 'prompt'
            ? 'Prompt copied. Paste it into your coding assistant.'
            : 'Install command copied.';
          resetTimer = setTimeout(() => {
            if (label) label.textContent = originalLabel;
          }, 2500);
        } catch {
          status.textContent = button.dataset.copyKind === 'prompt'
            ? 'Couldn’t copy. Select the prompt above and copy it manually.'
            : 'Couldn’t copy. Select the install command and copy it manually.';
        } finally {
          button.disabled = false;
        }
      });
    });
  }

  enhanceLandingCopy();
  document.addEventListener('astro:page-load', enhanceLandingCopy);
</script>

<style>
  /* Original landing experiment, using the existing Pubky design tokens. */
  .install-section {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    background: var(--base-background);
    padding: var(--spacing-16) 0 var(--spacing-12);
  }
  .install-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--install-section-bg);
    background-size: auto 100%;
    background-position: right top;
    background-repeat: no-repeat;
    opacity: 0.35;
    pointer-events: none;
  }
  .install-block {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-12);
    max-width: var(--landing-content-width);
    margin: 0 auto;
    padding: 0 var(--spacing-10);
    box-sizing: border-box;
    width: 100%;
  }
  .install-left, .install-right { min-width: 0; }
  .landing-eyebrow {
    margin: 0 0 var(--spacing-4);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    letter-spacing: var(--landing-label-tracking);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--base-secondary-foreground);
  }
  .install-heading {
    margin: 0;
    font-family: 'Inter Tight', var(--sl-font);
    font-size: var(--text-6xl-size);
    font-weight: 700;
    line-height: var(--text-6xl-lh);
    letter-spacing: var(--landing-heading-tracking);
    color: var(--base-foreground);
    text-wrap: balance;
  }
  .install-tagline {
    margin: var(--spacing-6) 0 0;
    max-width: var(--landing-body-measure);
    font-size: var(--text-lg-size);
    line-height: var(--text-lg-lh);
    color: var(--base-secondary-foreground);
  }
  .install-actions {
    display: flex;
    gap: var(--spacing-3);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--spacing-8);
  }
  .landing-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-height: var(--landing-touch-target);
    padding: var(--spacing-3) var(--spacing-5);
    border: var(--landing-border-width) solid transparent;
    border-radius: var(--radius-full);
    font-family: var(--sl-font);
    font-size: var(--text-sm-size);
    font-weight: 600;
    line-height: var(--text-sm-lh);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--landing-motion) ease, border-color var(--landing-motion) ease, color var(--landing-motion) ease;
  }
  .landing-button-primary { background: var(--brand-lime); color: var(--base-background); }
  .landing-button-primary:hover { background: var(--brand-lime-hover); }
  .landing-arrow { filter: brightness(0); transition: transform var(--landing-motion) ease; }
  .landing-button-primary:hover .landing-arrow { transform: translateX(var(--spacing-1)); }
  .landing-button-secondary {
    background: var(--alpha-white-5);
    border-color: var(--base-border);
    color: var(--base-foreground);
  }
  .landing-button-secondary:hover { background: var(--alpha-white-10); border-color: var(--base-muted-foreground); }
  .landing-source-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: var(--landing-touch-target);
    margin-top: var(--spacing-5);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    color: var(--base-muted-foreground);
    text-decoration: none;
    transition: color var(--landing-motion) ease;
  }
  .landing-source-link:hover, .starter-tools-link:hover { color: var(--base-foreground); }
  .landing-external-arrow { transform: rotate(-45deg); }
  .starter-panel {
    padding: var(--spacing-6);
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-xl);
    background: var(--landing-panel);
    box-shadow: var(--landing-shadow);
  }
  .starter-panel-heading { display: flex; gap: var(--spacing-3); align-items: center; }
  .starter-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--landing-touch-target);
    height: var(--landing-touch-target);
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-lg);
    background: var(--brand-lime-subtle);
  }
  .starter-panel .landing-eyebrow { margin-bottom: var(--spacing-1); color: var(--brand-lime); }
  .starter-panel h2 {
    margin: 0;
    font-family: 'Inter Tight', var(--sl-font);
    font-size: var(--text-xl-size);
    line-height: var(--text-xl-lh);
    font-weight: 600;
    color: var(--base-foreground);
  }
  .starter-description {
    margin: var(--spacing-4) 0;
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    color: var(--base-secondary-foreground);
  }
  .starter-prompt {
    margin: 0;
    padding: var(--spacing-4);
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-md);
    background: var(--base-background);
    font-family: var(--sl-font-mono);
    font-size: var(--text-xs-size);
    line-height: var(--text-sm-lh);
    color: var(--base-secondary-foreground);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: text;
  }
  .starter-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-2);
    flex-wrap: wrap;
    margin-top: var(--spacing-4);
  }
  .starter-copy { background: var(--base-secondary); color: var(--base-foreground); }
  .starter-copy:hover { background: var(--base-secondary-hover); }
  .starter-tools-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: var(--landing-touch-target);
    padding-inline: var(--spacing-2);
    color: var(--base-secondary-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    text-decoration: none;
    transition: color var(--landing-motion) ease;
  }
  .copy-status, .copy-fallback {
    margin: var(--spacing-2) 0 0;
    min-height: var(--text-xs-lh);
    color: var(--base-muted-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
  }
  .sdk-install {
    grid-column: 1 / -1;
    border-block: var(--landing-border-width) solid var(--base-border);
    color: var(--base-secondary-foreground);
  }
  .sdk-install summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    min-height: var(--landing-touch-target);
    padding-block: var(--spacing-4);
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    transition: color var(--landing-motion) ease;
  }
  .sdk-install summary::-webkit-details-marker { display: none; }
  .sdk-install summary:hover { color: var(--base-foreground); }
  .sdk-summary-title { font-weight: 600; color: var(--base-foreground); }
  .sdk-summary-languages { color: var(--base-muted-foreground); }
  .sdk-expand {
    margin-left: auto;
    font-size: var(--text-xl-size);
    line-height: var(--text-xl-lh);
    transition: transform var(--landing-motion) ease;
  }
  .sdk-install[open] .sdk-expand { transform: rotate(45deg); }
  .sdk-commands { display: flex; flex-direction: column; gap: var(--spacing-2); padding-bottom: var(--spacing-4); }
  .sdk-command-row {
    display: grid;
    grid-template-columns: 1fr 4fr auto;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-md);
    background: var(--landing-panel);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
  }
  .sdk-language { font-weight: 500; }
  .sdk-command-row code {
    padding: 0;
    background: transparent;
    color: var(--base-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    overflow-wrap: anywhere;
    user-select: text;
  }
  .sdk-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-width: var(--landing-touch-target);
    min-height: var(--landing-touch-target);
    padding: var(--spacing-2) var(--spacing-3);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--base-secondary-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    cursor: pointer;
    transition: background var(--landing-motion) ease, color var(--landing-motion) ease;
  }
  .sdk-copy:hover { background: var(--base-secondary); color: var(--base-foreground); }
  button[hidden] { display: none; }
  button:disabled { cursor: wait; opacity: 0.65; }

  @media (max-width: 1049px) {
    .install-section { padding: var(--spacing-10) 0 var(--spacing-12); }
    .install-block {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
      padding-inline: var(--sl-content-pad-x);
      gap: var(--spacing-8);
    }
    .install-heading { font-size: var(--text-5xl-size); line-height: var(--text-5xl-lh); }
    .install-right { width: 100%; }
    .starter-prompt { font-size: var(--text-sm-size); line-height: var(--text-base-lh); }
  }
  @media (max-width: 639px) {
    .install-section { padding-top: var(--spacing-6); }
    .install-tagline { font-size: var(--text-base-size); line-height: var(--text-base-lh); }
    .install-actions { gap: var(--spacing-2); margin-top: var(--spacing-6); }
    .install-actions .landing-button { padding-inline: var(--spacing-4); }
    .starter-panel { padding: var(--spacing-4); }
    .starter-mark { display: none; }
    .starter-prompt { font-size: var(--text-xs-size); line-height: var(--text-sm-lh); padding: var(--spacing-3); }
    .starter-actions { display: flex; flex-direction: column; align-items: stretch; }
    .starter-tools-link { justify-content: center; }
    .sdk-install summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--spacing-1) var(--spacing-4);
    }
    .sdk-summary-languages { grid-column: 1; font-size: var(--text-xs-size); line-height: var(--text-xs-lh); }
    .sdk-expand { grid-column: 2; grid-row: 1 / 3; }
    .sdk-command-row { grid-template-columns: minmax(0, 1fr) auto; gap: var(--spacing-1) var(--spacing-2); padding: var(--spacing-3); }
    .sdk-command-row code { grid-column: 1; font-size: var(--text-xs-size); line-height: var(--text-sm-lh); }
    .sdk-copy { grid-column: 2; grid-row: 1 / 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; }
  }
</style>
