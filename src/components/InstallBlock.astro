---
const commands = [
  { label: "npm", command: "npm install @synonymdev/pubky" },
  { label: "RN", command: "npm install @synonymdev/react-native-pubky" },
  { label: "Rust", command: "cargo add pubky" },
];

const SITE_URL = (import.meta.env.SITE_URL || "https://docs.pubky.org").replace(/\/+$/, "");

const aiPrompt = `Pubky: open protocol for key-based, censorship-resistant web apps. Public key identity, homeserver storage, Mainline DHT discovery over HTTP/REST.

Fetch the docs and help me build with Pubky:
- Full (~110k tokens): ${SITE_URL}/llms-full.txt
- Compact (~6k tokens): ${SITE_URL}/llms-small.txt`;

const aiLinks = [
  { name: "Claude", url: `https://claude.ai/new?q=${encodeURIComponent(aiPrompt)}`, icon: "claude" },
  { name: "ChatGPT", url: `https://chat.openai.com/?q=${encodeURIComponent(aiPrompt)}`, icon: "chatgpt" },
  { name: "Cursor", url: `https://cursor.com/link/prompt?text=${encodeURIComponent(aiPrompt)}`, icon: "cursor" },
  { name: "Gemini", url: `https://gemini.google.com/prompt?text=${encodeURIComponent(aiPrompt)}`, icon: "gemini" },
  { name: "Grok", url: `https://x.com/i/grok?text=${encodeURIComponent(aiPrompt)}`, icon: "grok" },
];
---

<div class="install-section">
  <div class="install-block">
  <div class="install-left not-content">
    <div class="install-header">
      <h1 class="install-heading">Build for User Sovereignty</h1>
      <p class="install-tagline">Open protocol for key-based, censorship-resistant apps</p>
    </div>

    <div class="install-actions">
      <a href="https://github.com/pubky/pubky-core" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub (opens in new tab)">
        <img class="btn-icon" src="/images/icons/github.svg" width="16" height="16" alt="" aria-hidden="true" />
        <span>GitHub</span>
      </a>
      <a href="https://docs.pubky.org" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" aria-label="Human Docs (opens in new tab)">
        <img class="btn-icon" src="/images/user.svg" width="16" height="16" alt="" aria-hidden="true" />
        <span>Human Docs</span>
      </a>
      <a href="https://github.com/pubky/pubky-ai-kit/" class="btn btn-ai-kit" target="_blank" rel="noopener noreferrer" aria-label="AI Kit (opens in new tab)">
        <img class="btn-icon" src="/images/icons/file.svg" width="16" height="16" alt="" aria-hidden="true" />
        <span>AI Kit</span>
      </a>
    </div>

    <div class="open-with">
      <span class="open-with-label">Open with:</span>
      <div class="open-with-links">
        {aiLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="open-with-btn" aria-label={`Open with ${link.name} (opens in new tab)`} data-tooltip={link.name}>
            <span class="ai-icon" data-icon={link.icon} aria-hidden="true"></span>
          </a>
        ))}
        <button class="copy-prompt-btn" aria-label="Copy prompt to clipboard" data-tooltip="Copy prompt" data-prompt={aiPrompt}>
          <span class="copy-prompt-label">Prompt</span>
          <img class="copy-prompt-icon" src="/images/icons/line-copy.svg" width="16" height="16" alt="" aria-hidden="true" />
          <svg class="copy-prompt-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#28c840" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="install-right not-content">
    <div class="terminal not-content">
      <div class="terminal-bar">
        <div class="dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <div class="tabs" role="tablist" aria-label="Package manager">
          {commands.map((cmd, i) => (
            <button
              class:list={["tab", { active: i === 0 }]}
              data-index={i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              {cmd.label}
            </button>
          ))}
        </div>
      </div>
      <div class="terminal-body">
        {commands.map((cmd, i) => (
          <div class:list={["command", { active: i === 0 }]} data-index={i}>
            <span class="prompt">$</span>
            <span class="cmd-text">{cmd.command}</span>
            <button class="copy-btn" data-command={cmd.command} aria-label="Copy to clipboard" aria-live="polite">
              <svg class="copy-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="check-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
</div>

<script>
  document.querySelectorAll('.install-block').forEach((block) => {
    const tabs = block.querySelectorAll('.tab');
    const commands = block.querySelectorAll('.command');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = tab.getAttribute('data-index');
        tabs.forEach((t) => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
        commands.forEach((c) => c.classList.remove('active'));
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        block.querySelector(`.command[data-index="${index}"]`)?.classList.add('active');
      });
    });

    block.querySelectorAll('.copy-prompt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const prompt = btn.getAttribute('data-prompt') || '';
        navigator.clipboard.writeText(prompt);
        btn.classList.add('copied');
        btn.setAttribute('data-tooltip', 'Copied!');
        btn.setAttribute('aria-label', 'Copied!');
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.setAttribute('data-tooltip', 'Copy prompt');
          btn.setAttribute('aria-label', 'Copy prompt to clipboard');
        }, 1500);
      });
    });

    block.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const command = btn.getAttribute('data-command') || '';
        navigator.clipboard.writeText(command);
        btn.classList.add('copied');
        btn.setAttribute('aria-label', 'Copied!');
        setTimeout(() => { btn.classList.remove('copied'); btn.setAttribute('aria-label', 'Copy to clipboard'); }, 1500);
      });
    });
  });
</script>

<style is:global>
  /* ── Install section (full-width hero wrapper) ── */
  .install-section {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    background: var(--base-background);
    padding: var(--spacing-10) 0;
  }

  /* Figma: Bg / Triangles (node 34690:86566) — 868x770 instance positioned at x=571
     in the 1280 frame, so its right edge sits 159px PAST the content right edge.
     Anchored relative to the centered content edge so it shifts right with viewport
     width. Height fills the section (top:0 + bottom:0) and width derives from the
     868:770 aspect ratio, which keeps the full triangle pattern visible at any
     desktop section height instead of clipping the bottom.
     159 is hardcoded — Figma right-overflow distance, no spacing token. */
  .install-section::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(50% - 640px - 159px);
    aspect-ratio: 868 / 770;
    background-image: url("/images/bg-square.png");
    background-size: contain;
    background-position: right top;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Two-column layout ── */
  /* Figma: Top Hero = flex row, 1280px container with 40px padding = 1200px content */
  .install-block {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-10);
    box-sizing: border-box;
    width: 100%;
  }

  /* Figma: Left col = flex-1, flex-col, gap spacing-6(24), pt spacing-10(40), h 500.
     500px is hardcoded — one-off Figma layout dimension, no spacing token */
  .install-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 500px;
    padding-top: var(--spacing-10);
  }

  /* Figma: Content = flex-col, gap spacing-6(24) */
  .install-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  /* Figma: H1 (node 34690:85314) = Inter Tight Bold, text-6xl (72px/72px), foreground white */
  .install-heading {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-6xl-size);
    font-weight: 700;
    line-height: var(--text-6xl-lh);
    color: var(--base-foreground);
  }

  /* Figma: H5 (node 34690:85316) = Inter Tight Light(300), text-xl (20px/28px),
     muted-foreground */
  .install-tagline {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-xl-size);
    font-weight: 300;
    line-height: var(--text-xl-lh);
    color: var(--base-muted-foreground);
  }

  /* ── Buttons row ── */
  /* Figma: gap spacing-6(24) */
  .install-actions {
    display: flex;
    gap: var(--spacing-6);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--spacing-6);
  }

  /* Figma: h 60, px spacing-8(32), py spacing-5(20), gap spacing-2(8), font text-sm(14/20) bold, radius full(9999), shadow xs */
  .install-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    height: 60px;
    padding: var(--spacing-5) var(--spacing-8);
    border-radius: var(--radius-full);
    font-size: var(--text-sm-size);
    font-weight: 700;
    line-height: var(--text-sm-lh);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    box-shadow: var(--shadow-xs);
    border: none;
  }

  .install-actions .btn-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Figma: Secondary variant — bg base/secondary(#303034), text base/secondary-foreground(#d4d4db) */
  .install-actions .btn-secondary {
    background: var(--base-secondary);
    color: var(--base-secondary-foreground);
  }

  .install-actions .btn-secondary:hover {
    background: var(--base-secondary-hover);
    color: var(--base-foreground);
  }

  /* Figma: AI Kit variant — bg alpha/white-16, text base/secondary-foreground(#d4d4db) */
  .install-actions .btn-ai-kit {
    background: var(--alpha-white-16);
    color: var(--base-secondary-foreground);
  }

  .install-actions .btn-ai-kit:hover {
    background: rgba(255, 255, 255, 0.24); /* Not in Figma — brighter than alpha-white-16 for hover feedback */
    color: var(--base-foreground);
  }

  /* ── Open with row ── */
  /* Figma: AI section = flex-col, gap spacing-2(8), justify center */
  .open-with {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin-top: var(--spacing-6);
    flex: 1;
    justify-content: center;
  }

  /* Figma: P (node 34690:85321) = Inter Tight Medium, text-base(16/24), foreground */
  .open-with-label {
    color: var(--base-foreground);
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-base-size);
    font-weight: 500;
    line-height: var(--text-base-lh);
  }

  /* Figma: Row = flex, gap spacing-3(12) */
  .open-with-links {
    display: flex;
    gap: var(--spacing-3);
  }

  .open-with-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
    /* WCAG: expand touch target to 44px minimum */
    padding: 6px;
    margin: -6px;
  }

  .open-with-btn:hover > .ai-icon {
    opacity: 0.75;
  }

  /* ── Tooltip ── */
  .open-with-btn[data-tooltip],
  .copy-prompt-btn[data-tooltip] {
    position: relative;
  }

  .open-with-btn[data-tooltip]::after,
  .copy-prompt-btn[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 8px;
    background: var(--base-card);
    color: var(--base-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    font-weight: 500;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    border: 1px solid var(--base-border);
  }

  .open-with-btn[data-tooltip]:hover::after,
  .copy-prompt-btn[data-tooltip]:hover::after {
    opacity: 1;
  }

  /* ── Copy prompt button ── */
  /* Figma: bg alpha-white-5, border 1px base/border, radius full, shadow xs, px spacing-4(16), py spacing-2-5(10), gap spacing-2(8) */
  .copy-prompt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-height: 44px; /* WCAG: 44px minimum touch target */
    padding: var(--spacing-2-5) var(--spacing-4);
    background: var(--alpha-white-5);
    border: 1px solid var(--base-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    color: var(--base-foreground);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  /* Not in Figma — added for hover feedback */
  .copy-prompt-btn:hover {
    background: var(--alpha-white-10);
    border-color: var(--base-muted-foreground);
  }

  /* Figma: text-sm(14/20) bold, foreground */
  .copy-prompt-label {
    font-family: var(--sl-font);
    font-size: var(--text-sm-size);
    font-weight: 700;
    line-height: var(--text-sm-lh);
  }

  .copy-prompt-btn .copy-prompt-check { display: none; }
  .copy-prompt-btn.copied .copy-prompt-icon { display: none; }
  .copy-prompt-btn.copied .copy-prompt-check { display: block; }

  /* Figma: Logos = 32x32, border-radius rounded-sm(6) */
  .ai-icon {
    display: inline-block;
    width: 32px;
    height: 32px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: var(--radius-sm);
  }

  .ai-icon[data-icon="claude"] { background-image: url("/images/ai-icons/claude.png"); }
  .ai-icon[data-icon="chatgpt"] { background-image: url("/images/ai-icons/chatgpt.png"); }
  .ai-icon[data-icon="cursor"] { background-image: url("/images/ai-icons/cursor.png"); }
  .ai-icon[data-icon="gemini"] { background-image: url("/images/ai-icons/gemini.png"); }
  /* Figma: Grok logo has white background unlike others which have it baked into the image */
  .ai-icon[data-icon="grok"] { background-image: url("/images/ai-icons/grok.png"); background-color: white; }

  /* ── Right column ── */
  /* Figma: flex-1, flex-col, gap spacing-6(24), items center, centered vertically.
     500px height matches install-left — one-off layout dimension.
     Background pattern lives on .install-section::before, not here. */
  .install-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-6);
    height: 500px;
  }

  /* ── Terminal ── */
  /* Figma: 500x140, border 1px base/border, radius rounded-xl(16), bg base/background, overflow clip */
  .terminal {
    width: 500px;
    height: 140px;
    border: 1px solid var(--base-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--base-background);
    display: flex;
    flex-direction: column;
  }

  /* Figma: Dots bar = px spacing-4(16), py 8, bg base/card(#1d1d20), gap 11.
     11px is hardcoded — Figma-specific value, doesn't fit 4px spacing scale */
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--base-card);
  }

  /* Figma: dots = 9px, gap 11px (same oddball spacing as terminal-bar) */
  .dots {
    display: flex;
    gap: 11px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  /* Figma: Tabs = w 200, h 48, p spacing-2(8), gap spacing-2(8), radius rounded-md(8) */
  .tabs {
    display: flex;
    align-items: center;
    width: 200px;
    height: 48px;
    padding: var(--spacing-2);
    gap: var(--spacing-2);
    border-radius: var(--radius-md);
  }

  /* Figma: Tab trigger = flex-1, p spacing-2(8), radius rounded-md(8), text-xs(12/16) bold */
  .tab {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--base-secondary-foreground);
    font-family: var(--sl-font);
    font-size: var(--text-xs-size);
    font-weight: 700;
    line-height: var(--text-xs-lh);
    padding: var(--spacing-2);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }

  .tab:hover {
    color: var(--base-foreground);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Figma: Active tab = bg base/muted(#303034), text foreground, shadow sm */
  .tab.active {
    color: var(--base-foreground);
    background: var(--base-muted);
    box-shadow: var(--shadow-sm);
  }

  /* Figma: Terminal body = flex-1, p spacing-4(16), gap spacing-4(16), items center */
  .terminal-body {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
  }

  /* Figma: Large typography = text-lg(18/28) semibold, items-center inherited from .terminal-body */
  .command {
    display: none;
    align-items: center;
    gap: var(--spacing-4);
    font-family: var(--sl-font);
    font-size: var(--text-lg-size);
    font-weight: 600;
    line-height: var(--text-lg-lh);
    width: 100%;
  }

  .command.active {
    display: flex;
  }

  /* Figma: $ prompt = muted-foreground */
  .prompt {
    color: var(--base-muted-foreground);
    user-select: none;
  }

  /* Figma: command text = foreground */
  .cmd-text {
    color: var(--base-foreground);
    flex: 1;
    letter-spacing: -1px;
  }

  /* Figma: Ghost icon button = 36x36, p spacing-1(4), radius full(9999) */
  .copy-btn {
    background: transparent;
    border: none;
    color: var(--base-muted-foreground);
    cursor: pointer;
    width: 36px;
    height: 36px;
    padding: var(--spacing-1);
    border-radius: var(--radius-full);
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    color: var(--base-foreground);
    background: rgba(255, 255, 255, 0.06);
  }

  .copy-btn .check-icon { display: none; }
  .copy-btn.copied .copy-icon { display: none; }
  .copy-btn.copied .check-icon { display: block; color: #28c840; }

  /* ── Mobile ── */
  /* Figma: Mobile 390px — hero stacks vertically, heading 60px/1, buttons keep 60px height flex-1, 24px side padding.
     Breakpoint raised to 1050px — at 768px the two columns are too cramped */
  @media (max-width: 1049px) {
    /* Figma Mobile: install-section spans full viewport width so the Bg / Triangles
       pattern sits flush at viewport edges. Use an explicit negative content
       padding (matches the home-content breakout below — see AGENTS.md invariant)
       so the layouts stay symmetric. overflow: visible lets the bg extend past
       the section bottom into the gap above Quick Start; html { overflow-x: hidden }
       still clips the 70px horizontal overhang. */
    .install-section {
      width: 100vw;
      margin-left: calc(var(--sl-content-pad-x) * -1);
      margin-bottom: var(--spacing-20);
      padding: 0;
      overflow: visible;
    }

    /* Figma Mobile: Top Hero flex-col gap-12(48) between the AI block (left col)
       and the SDK block. install-block re-adds spacing-6 (24px) horizontal
       padding so hero content stays within the 342px content width aligned
       with the home sections below (which inherit the same Starlight padding). */
    .install-block {
      flex-direction: column;
      gap: var(--spacing-12);
      padding: 0 var(--spacing-6);
    }

    .install-left {
      padding-top: var(--spacing-4);
      height: auto;
    }

    /* Figma Mobile (node 34784:60725): the SDK block has py-4(16), and its
       Content frame contains an empty Typography/H3 placeholder (32px) plus
       gap-6(24) above the terminal. We don't render the H3, so absorb its
       space into padding-top: 16 + 32 + 24 = 72px. */
    .install-right {
      padding: calc(var(--spacing-4) + var(--spacing-8) + var(--spacing-6)) 0
        var(--spacing-4);
      height: auto;
      align-items: center;
      width: 100%;
    }

    /* Figma Mobile (node 34784:61327): Bg / Triangles at x=0, y=608, 460x407 in
       the 390x844 viewport. The pattern's bottom (y=1015) sits 127px past the
       Top Hero bottom (y=888), which we replicate via bottom: -127px — the bottom
       127px of the pattern overflows past .install-section and is clipped by
       overflow:hidden, leaving the top 280px visible. This also keeps the bg's
       top edge below the AI section so it doesn't overlap the Prompt button. */
    .install-section::before {
      top: auto;
      bottom: -127px;
      left: 0;
      right: auto;
      width: 460px;
      height: 407px;
    }

    /* Figma: Mobile H1 = responsive size, bold, leading-none */
    .install-heading {
      font-size: clamp(40px, 12vw, 60px);
      line-height: 1;
      overflow-wrap: break-word;
    }

    /* Figma Mobile: Buttons stack as 2-up grid for GitHub+Human Docs, then AI Kit full-width.
       Row gap spacing-6(24), column gap spacing-6(24) */
    .install-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-6);
    }

    .install-actions .btn {
      padding: var(--spacing-5) var(--spacing-4);
