---
import { withBase } from '../utils/base-path';
import { Tabs, TabItem } from '@astrojs/starlight/components';
import AiResources from './AiResources.astro';

const commands = [
  { label: "npm", command: "npm install @synonymdev/pubky" },
  { label: "RN", command: "npm install @synonymdev/react-native-pubky" },
  { label: "Rust", command: "cargo add pubky" },
];

// Keep the starter prompt tied to the maintained production documentation.
const aiPrompt = `Help me build an app with Pubky: public-key identity and user-owned data.

First ask what I want to build and which language or framework I use.

Read https://pubky.org/llms-small.txt, then fetch only the relevant .md pages. Start with https://pubky.org/explore/pubky-protocol/getting-started.md when appropriate.

Before writing code, check my installed SDK version against its maintained upstream documentation. Cite the sources you use and flag anything you cannot verify.`;

const aiLinks = [
  { name: "Claude", url: `https://claude.ai/new?q=${encodeURIComponent(aiPrompt)}`, icon: "claude" },
  { name: "ChatGPT", url: `https://chat.openai.com/?q=${encodeURIComponent(aiPrompt)}`, icon: "chatgpt" },
  { name: "Cursor", url: `https://cursor.com/link/prompt?text=${encodeURIComponent(aiPrompt)}`, icon: "cursor" },
  { name: "Gemini", url: "https://gemini.google.com/", icon: "gemini", tooltip: "Gemini: Autofill unsupported. Copy-paste manually." },
  { name: "Grok", url: `https://x.com/i/grok?text=${encodeURIComponent(aiPrompt)}`, icon: "grok" },
];

const iconUrl = (icon: string) => `--ai-icon-url: url("${withBase(`/images/ai-icons/${icon}.png`)}")`;
const installSectionBg = `--install-section-bg: url("${withBase('/images/bg-square.png')}")`;
---

<div class="install-section" style={installSectionBg}>
  <div class="install-block">
  <div class="install-left not-content">
    <div class="install-header">
      <h1 class="install-heading">Build for User Sovereignty</h1>
      <p class="install-tagline">Open protocol for key-based, censorship-resistant apps</p>
    </div>

    <div class="install-actions">
      <a href="https://github.com/pubky/pubky-homeserver" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub (opens in new tab)">
        <img class="btn-icon" src={withBase('/images/icons/github.svg')} width="16" height="16" alt="" aria-hidden="true" />
        <span>GitHub</span>
      </a>
      <a href={withBase('/overview/')} class="btn btn-secondary" aria-label="Human Docs">
        <img class="btn-icon" src={withBase('/images/user.svg')} width="16" height="16" alt="" aria-hidden="true" />
        <span>Human Docs</span>
      </a>
    </div>

    <div class="open-with">
      <span class="open-with-label">pubky.org for your LLM</span>
      <div class="open-with-row">
        <div class="open-with-links">
          {aiLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="open-with-btn" aria-label={`Open with ${link.name} (opens in new tab)`} data-tooltip={link.tooltip ?? link.name}>
              <span class="ai-icon" data-icon={link.icon} aria-hidden="true" style={iconUrl(link.icon)}></span>
            </a>
          ))}
          <button type="button" class="copy-prompt-btn" aria-label="Copy prompt to clipboard" data-tooltip="Copy prompt" data-copy-text={aiPrompt} data-copy-kind="prompt" data-copy-status="starter-copy-status" hidden>
            <span class="copy-prompt-label" data-copy-label>Prompt</span>
            <img class="copy-prompt-icon" src={withBase('/images/icons/line-copy.svg')} width="16" height="16" alt="" aria-hidden="true" />
          </button>
        </div>
      </div>
      <details class="prompt-details" id="pubky-starter-prompt">
        <summary>Show starter prompt</summary>
        <pre class="starter-prompt" tabindex="0" aria-label="Selectable Pubky starter prompt">{aiPrompt}</pre>
      </details>
      <p id="starter-copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>

  <div class="install-right not-content">
    <div class="install-terminal terminal-tabs">
      <Tabs>
        {commands.map((cmd) => (
          <TabItem label={cmd.label}>
            <div class="install-command">
              <span class="prompt">$</span>
              <span class="cmd-text">{cmd.command}</span>
              <button type="button" class="copy-btn" data-copy-text={cmd.command} data-copy-kind="command" data-copy-status="sdk-copy-status" aria-label={`Copy ${cmd.label} install command`} hidden>
                <img class="copy-icon" src={withBase('/images/icons/line-copy.svg')} width="20" height="20" alt="" aria-hidden="true" />
              </button>
            </div>
          </TabItem>
        ))}
      </Tabs>
      <p id="sdk-copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
    <AiResources />
  </div>
</div>
</div>

<script>
  import { enhanceClipboardButton } from '../scripts/clipboard';

  function enhanceLandingCopy() {
    document.querySelectorAll<HTMLButtonElement>('.install-block [data-copy-text]').forEach((button) => {
      const status = document.getElementById(button.dataset.copyStatus ?? '');
      const text = button.dataset.copyText;
      if (!status || !text) return;
      const isPrompt = button.dataset.copyKind === 'prompt';

      enhanceClipboardButton(button, {
        text,
        status,
        successMessage: isPrompt
          ? 'Prompt copied. Paste it into your coding assistant.'
          : 'Install command copied.',
        failureMessage: isPrompt
          ? 'Couldn’t copy. Select the prompt shown above and copy it manually.'
          : 'Couldn’t copy. Select the install command and copy it manually.',
        successAriaLabel: isPrompt ? 'Prompt copied' : 'Install command copied',
        onFailure: isPrompt ? () => {
          const promptDetails = document.getElementById('pubky-starter-prompt');
          if (promptDetails instanceof HTMLDetailsElement) promptDetails.open = true;
        } : undefined,
      });
    });
  }

  enhanceLandingCopy();
  document.addEventListener('astro:page-load', enhanceLandingCopy);
</script>

<style is:global>
  /* ── Install section (full-width hero wrapper) ── */
  .install-section {
    position: relative;
    overflow: visible;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    background: var(--base-background);
    padding: var(--spacing-10) 0;
  }

  /* Figma: Bg / Triangles (node 34690:86566) — 868x770 instance positioned at x=571
     in the 1280 frame, so its right edge sits 159px PAST the content right edge.
     Anchored relative to the centered content edge so it shifts right with viewport
     width. Height fills the section (top:0 + bottom:0) and width derives from the
     868:770 aspect ratio, which keeps the full triangle pattern visible at any
     desktop section height instead of clipping the bottom.
     159 is hardcoded — Figma right-overflow distance, no spacing token. */
  .install-section::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(50% - 640px - 159px);
    aspect-ratio: 868 / 770;
    background-image: var(--install-section-bg);
    background-size: contain;
    background-position: right top;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Two-column layout ── */
  /* Figma: Top Hero = flex row, 1280px container with 40px padding = 1200px content */
  .install-block {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-10);
    box-sizing: border-box;
    width: 100%;
  }

  /* Figma: Left col = flex-1, flex-col, gap spacing-6(24), pt spacing-10(40), h 500.
     500px is hardcoded — one-off Figma layout dimension, no spacing token */
  .install-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 500px;
    padding-top: var(--spacing-10);
  }

  /* Figma: Content = flex-col, gap spacing-6(24) */
  .install-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  /* Figma: H1 (node 34690:85314) = Inter Tight Bold, text-6xl (72px/72px), foreground white */
  .install-heading {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-6xl-size);
    font-weight: 700;
    line-height: var(--text-6xl-lh);
    color: var(--base-foreground);
  }

  /* Figma: H5 (node 34690:85316) = Inter Tight Light(300), text-xl (20px/28px),
     muted-foreground */
  .install-tagline {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-xl-size);
    font-weight: 300;
    line-height: var(--text-xl-lh);
    color: var(--base-muted-foreground);
  }

  /* ── Buttons row ── */
  /* Figma: gap spacing-6(24) */
  .install-actions {
    display: flex;
    gap: var(--spacing-6);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--spacing-6);
  }

  /* Figma: h 60, px spacing-8(32), py spacing-5(20), gap spacing-2(8), font text-sm(14/20) bold, radius full(9999), shadow xs */
  .install-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    height: 60px;
    padding: var(--spacing-5) var(--spacing-8);
    border-radius: var(--radius-full);
    font-size: var(--text-sm-size);
    font-weight: 700;
    line-height: var(--text-sm-lh);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    box-shadow: var(--shadow-xs);
    border: none;
  }

  .install-actions .btn-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Figma: Secondary variant — bg base/secondary(#303034), text base/secondary-foreground(#d4d4db) */
  .install-actions .btn-secondary {
    background: var(--base-secondary);
    color: var(--base-secondary-foreground);
  }

  .install-actions .btn-secondary:hover {
    background: var(--base-secondary-hover);
    color: var(--base-foreground);
  }

  /* ── Open with row ── */
  /* Keep the launcher at the bottom of the desktop hero, opposite the AI card. */
  .open-with {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin-top: auto;
    padding-top: var(--spacing-12);
  }

  /* Figma: P (node 34690:85321) = Inter Tight Medium, text-base(16/24), foreground */
  .open-with-label {
    color: var(--base-foreground);
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-base-size);
    font-weight: 500;
    line-height: var(--text-base-lh);
  }

  /* Preserve the original provider row with a quiet, static border. */
  .open-with-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: flex-start;
    max-width: 100%;
  }

  .open-with-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-4) var(--spacing-6);
    background: var(--base-background);
    border: 1px solid var(--base-card);
    border-radius: var(--radius-lg);
  }

  .open-with-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
    /* WCAG: expand touch target to 44px minimum */
    padding: 6px;
    margin: -6px;
  }

  .open-with-btn:hover > .ai-icon {
    opacity: 0.75;
  }

  /* ── Tooltip ── */
  .open-with-btn[data-tooltip],
  .copy-prompt-btn[data-tooltip] {
    position: relative;
  }

  .open-with-btn[data-tooltip]::after,
  .copy-prompt-btn[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 8px;
    background: var(--base-card);
    color: var(--base-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    font-weight: 500;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    border: 1px solid var(--base-border);
  }

  .open-with-btn[data-tooltip]:hover::after,
  .open-with-btn[data-tooltip]:focus-visible::after,
  .copy-prompt-btn[data-tooltip]:hover::after,
  .copy-prompt-btn[data-tooltip]:focus-visible::after {
    opacity: 1;
  }

  /* ── Copy prompt button ── */
  /* Figma: bg alpha-white-5, border 1px base/border, radius full, shadow xs, px spacing-4(16), py spacing-2-5(10), gap spacing-2(8) */
  .copy-prompt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-height: 44px; /* WCAG: 44px minimum touch target */
    padding: var(--spacing-2-5) var(--spacing-4);
    background: var(--alpha-white-5);
    border: 1px solid var(--base-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    color: var(--base-foreground);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  /* Not in Figma — added for hover feedback */
  .copy-prompt-btn:hover {
    background: var(--alpha-white-10);
    border-color: var(--base-muted-foreground);
  }

  /* Figma: text-sm(14/20) bold, foreground */
  .copy-prompt-label {
    font-family: var(--sl-font);
    font-size: var(--text-sm-size);
    font-weight: 700;
    line-height: var(--text-sm-lh);
  }

  /* Figma: Logos = 40x40, border-radius rounded-sm(6) */
  .ai-icon {
    display: inline-block;
    width: 40px;
    height: 40px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: var(--radius-sm);
  }

  .ai-icon { background-image: var(--ai-icon-url); }
  /* Figma: Grok logo has white background unlike others which have it baked into the image */
  .ai-icon[data-icon="grok"] { background-color: white; }

  /* ── Right column ── */
  /* Keep the SDK above the resource card and align the card with the launcher. */
  .install-right {
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-6);
    min-width: 0;
    min-height: 500px;
  }

  /* ── Install terminal (Starlight Tabs) ── */
  /* Figma: 500x140 terminal */
  .install-terminal {
    width: 500px;
  }

  .install-terminal starlight-tabs > [role="tabpanel"] {
    padding: var(--spacing-4);
  }

  .install-terminal starlight-tabs [role="tab"] {
    min-width: var(--landing-touch-target);
    min-height: var(--landing-touch-target);
  }

  /* Figma: Large typography = text-lg(18/28) semibold */
  .install-command {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    font-family: var(--sl-font);
    font-size: var(--text-lg-size);
    font-weight: 600;
    line-height: var(--text-lg-lh);
  }

  /* Figma: $ prompt = muted-foreground */
  .prompt {
    color: var(--base-muted-foreground);
    user-select: none;
  }

  /* Figma: command text = foreground */
  .cmd-text {
    color: var(--base-foreground);
    flex: 1;
    letter-spacing: -1px;
  }

  /* Figma: Ghost icon button = 36x36, p spacing-1(4), radius full(9999) */
  .copy-btn {
    background: transparent;
    border: none;
    color: var(--base-muted-foreground);
    cursor: pointer;
    width: var(--landing-touch-target);
    height: var(--landing-touch-target);
    padding: var(--spacing-1);
    border-radius: var(--radius-full);
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    color: var(--base-foreground);
    background: var(--alpha-white-5);
  }

  .prompt-details { width: 100%; }
  .prompt-details > summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    width: fit-content;
    min-height: var(--landing-touch-target);
    color: var(--base-muted-foreground);
    cursor: pointer;
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    transition: color var(--landing-motion) ease;
  }
  .prompt-details > summary::before { content: '+'; }
  .prompt-details[open] > summary::before { content: '−'; }
  .prompt-details > summary:hover { color: var(--base-foreground); }
  .starter-prompt {
    margin: 0;
    padding: var(--spacing-4);
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-md);
    background: var(--base-background);
    color: var(--base-secondary-foreground);
    font-family: var(--sl-font);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: text;
  }
  .copy-status {
    margin: 0;
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    color: var(--base-secondary-foreground);
  }
  .copy-status:not(:empty) { margin-top: var(--spacing-2); }
  .install-terminal .copy-status { padding-inline: var(--spacing-4); }
  .install-block button[hidden] { display: none; }
  .install-block button:disabled { cursor: wait; }

  /* ── Mobile ── */
  /* Figma: Mobile 390px — hero stacks vertically, heading 60px/1, buttons keep 60px height flex-1, 24px side padding.
     Breakpoint raised to 1050px — at 768px the two columns are too cramped */
  @media (max-width: 1049px) {
    /* Figma Mobile: install-section spans full viewport width so the Bg / Triangles
       pattern sits flush at viewport edges. Use an explicit negative content
       padding (matches the home-content breakout below — see AGENTS.md invariant)
       so the layouts stay symmetric. overflow: visible lets the bg extend past
       the section bottom into the gap above Quick Start; html { overflow-x: hidden }
       still clips the 70px horizontal overhang. */
    .install-section {
      width: 100vw;
      margin-left: calc(var(--sl-content-pad-x) * -1);
      margin-bottom: var(--spacing-20);
      padding: 0;
      overflow: visible;
    }

    /* Figma Mobile: Top Hero flex-col gap-12(48) between the AI block (left col)
       and the SDK block. install-block re-adds spacing-6 (24px) horizontal
       padding so hero content stays within the 342px content width aligned
       with the home sections below (which inherit the same Starlight padding). */
    .install-block {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-6);
      padding: 0 var(--spacing-6);
    }

    .install-left {
      padding-top: var(--spacing-4);
      min-height: 0;
    }

    .open-with {
      margin-top: var(--spacing-10);
      padding-top: 0;
    }

    /* Keep the SDK terminal and AI resources together in document order. */
    .install-right {
      padding: 0 0 var(--spacing-4);
      min-height: 0;
      align-items: center;
      width: 100%;
    }

    /* Figma Mobile (node 34784:61327): Bg / Triangles at x=0, y=608, 460x407 in
       the 390x844 viewport. The pattern's bottom (y=1015) sits 127px past the
       Top Hero bottom (y=888), which we replicate via bottom: -127px — the bottom
       127px of the pattern overflows past .install-section and is clipped by
       overflow:hidden, leaving the top 280px visible. This also keeps the bg's
       top edge below the AI section so it doesn't overlap the Prompt button. */
    .install-section::before {
      top: auto;
      bottom: -127px;
      left: 0;
      right: auto;
      width: 460px;
      height: 407px;
    }

    /* Figma: Mobile H1 = responsive size, bold, leading-none */
    .install-heading {
      font-size: clamp(40px, 12vw, 60px);
      line-height: 1;
      overflow-wrap: break-word;
    }

    /* Preserve the original two-column GitHub and Human Docs button row. */
    .install-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-6);
    }

    .install-actions .btn {
      padding: var(--spacing-5) var(--spacing-4);
      white-space: nowrap;
    }

    /* Restore the original mobile icons and spacing; wrap only when needed. */
    .ai-icon {
      width: 32px;
      height: 32px;
    }

    .open-with-row { max-width: 100%; }
    .open-with-links {
      flex-wrap: wrap;
      max-width: 100%;
      box-sizing: border-box;
      gap: var(--spacing-2);
      padding: var(--spacing-3) var(--spacing-4);
    }
    .copy-prompt-btn {
      flex-shrink: 0;
      padding-inline: var(--spacing-3);
    }

    .install-terminal {
      width: 100%;
    }

    .install-command {
      font-size: var(--text-sm-size);
      line-height: var(--text-sm-lh);
    }
    .cmd-text { overflow-wrap: anywhere; }
  }

  @media (prefers-reduced-motion: reduce) {
    .install-actions .btn,
    .prompt-details > summary,
    .copy-prompt-btn,
    .open-with-btn,
    .open-with-btn[data-tooltip]::after,
    .copy-prompt-btn[data-tooltip]::after,
    .copy-btn,
    .install-terminal starlight-tabs [role="tab"] { transition: none; }
  }
</style>
