---
import InstallBlock from "./InstallBlock.astro";
import TextCard from "./TextCard.astro";
import ImageCard from "./ImageCard.astro";
import DemoCard from "./DemoCard.astro";
import { withBase } from "../utils/base-path";

// Figma: Demos (node 34702:87731) — Hackathon projects, 11 cards
const demos = [
  {
    title: "mypubky",
    description:
      "A shareable identity card that brings your Pubky identifier, avatar, bio, links, posts, profile tags, and Paykit-powered donation options into one visual page.",
    actions: [
      { label: "Live Demo", href: "https://mypubky.com/", variant: "secondary" as const },
      {
        label: "Read More",
        href: "https://github.com/pubky/mypubky",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "Payky",
    description:
      "A linktree like page for payments, based on Paykit, where the user can connect using Pubky Ring and add their payment details (crypto, fiat etc.) and share a link to the page with anyone.",
    actions: [{ label: "Live Demo", href: "https://payky.app/", variant: "secondary" as const }],
  },
  {
    title: "ABC",
    description:
      "Drop-In Pubky Comment Widget for Blogs\n\nSimple embeddable script that lets any website add Pubky-based comments.",
    actions: [
      {
        label: "Live Demo",
        href: "https://ok300.github.io/abc-prague-hugo/posts/abc-launch/",
        variant: "secondary" as const,
      },
      {
        label: "Read More",
        href: "https://github.com/aintnostressin/abc-team-hackathon-prague",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "Mapky",
    description:
      "A social layer for OpenStreetMap with place reviews, posts, routes, collections, and geo-captures stored as user-owned data.",
    actions: [
      { label: "Live Demo", href: "https://mapky.app/", variant: "secondary" as const },
      {
        label: "Read More",
        href: "https://github.com/gillohner/mapky-app",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "Passport",
    description:
      "Pubky Passport uses Google login to create or access an encrypted Pubky key in Google Drive, where neither Google nor the Pubky Passport server can decrypt it alone.",
    actions: [
      {
        label: "Live Demo",
        href: "https://passport.buhlerlabs.com",
        variant: "secondary" as const,
      },
      {
        label: "Read More",
        href: "https://github.com/SeverinAlexB/pubky-passport-prague26",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "Explorer",
    description: "A file explorer that allows you to navigate data stored on your Homeserver.",
    actions: [
      { label: "Live Demo", href: "https://explorer.pubky.app/", variant: "secondary" as const },
      {
        label: "Read More",
        href: "https://github.com/pubky/pubky-explorer",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "Eventky",
    description:
      "A social calendar and event management app using existing calendar standards, with event data stored on each user’s homeserver.",
    actions: [
      { label: "Live Demo", href: "https://eventky.app/", variant: "secondary" as const },
      {
        label: "Read More",
        href: "https://github.com/gillohner/eventky",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "PKDNS",
    description:
      "A DNS server providing self-sovereign and censorship-resistant domain names based on PKARR.",
    actions: [
      { label: "Live Demo", href: "https://pkdns.net/", variant: "secondary" as const },
      {
        label: "Read More",
        href: "https://github.com/pubky/pkdns",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "PubkyLab",
    description:
      "An interactive web-based playground for testing and experimenting with the Pubky SDK.",
    actions: [
      {
        label: "Live Demo",
        href: "https://jvsena42.github.io/pubky-lab/",
        variant: "secondary" as const,
      },
      {
        label: "Read More",
        href: "https://github.com/jvsena42/pubky-lab",
        variant: "outline" as const,
      },
    ],
  },
  {
    title: "No Registry",
    description: "Self-host PKDNS in under 10 minutes with a simple Pi-hole or Docker setup.",
    actions: [
      { label: "Read More", href: "https://www.noregistry.com/", variant: "outline" as const },
    ],
  },
  {
    title: "Echo",
    description:
      "A modern mobile flashcard app where your decks live on your homeserver and sync across devices.",
    actions: [
      {
        label: "Read More",
        href: "https://github.com/jvsena42/echo",
        variant: "outline" as const,
      },
    ],
  },
];

// Figma: pubky.app icon = green brand mark, Pubky Ring/Core/Apps icon = white brand mark
const pubkyBrandGreen = `<img src="${withBase('/images/icons/pubky-brand.svg')}" height="22" alt="" />`;
const pubkyBrandWhite = `<img src="${withBase('/images/icons/pubky-brand-white.svg')}" height="22" alt="" />`;

// Icon file paths — all exported from Figma as SVGs
const icons = {
  // Quick Start
  timer: '/images/icons/timer.svg',
  codeXml: '/images/icons/code-xml.svg',
  file: '/images/icons/file.svg',
  circleHelp: '/images/icons/circle-help.svg',
  // Key Concepts
  fingerprint: '/images/icons/fingerprint.svg',
  shieldOff: '/images/icons/shield-off.svg',
  arrowLeftRight: '/images/icons/arrow-left-right.svg',
  lineChart: '/images/icons/line-chart.svg',
};
---

<InstallBlock />

<div class="home-content not-content">
  <!-- Quick Start -->
  <section id="quick-start" class="home-section">
    <h2 class="home-section-title home-section-title-sm">
      <a class="home-section-title-link" href="#quick-start">Quick Start</a>
    </h2>
    <div class="home-section-box">
    <div class="card-grid card-grid-4">
      <TextCard
        title="TL;DR"
        description="30-second overview of the entire ecosystem"
        href="/tldr/"
        icon={icons.timer}
      />
      <TextCard
        title="Getting Started"
        description="Complete guide for users and developers"
        href="/getting-started/"
        icon={icons.codeXml}
      />
      <TextCard
        title="Glossary"
        description="Quick reference for key terms"
        href="/glossary/"
        icon={icons.file}
      />
      <TextCard
        title="FAQ"
        description="63+ questions answered across key topics and features"
        href="/faq/"
        icon={icons.circleHelp}
      />
    </div>
    </div>
  </section>

  <!-- For Users + For Developers — wrapped to equalize card heights across both sections -->
  <div class="image-card-sections">
    <section id="for-users" class="home-section">
      <h2 class="home-section-title">
        <a class="home-section-title-link" href="#for-users">For Users</a>
      </h2>
      <div class="card-grid card-grid-3">
        <ImageCard
          title="Pubky"
          titleIcon={pubkyBrandGreen}
          image="/images/cards/pubky.png"
          links={[{ label: "Join pubky.app", href: "https://pubky.app", external: true }]}
        />
        <ImageCard
          title="Pubky"
          titleSuffix="Ring"
          titleIcon={pubkyBrandWhite}
          image="/images/cards/pubky-ring.png"
          links={[
            { label: "Website", href: "https://pubkyring.app/", external: true },
            { label: "Learn More", href: "/explore/technologies/pubky-ring/" },
          ]}
        />
        <ImageCard
          title="Pubky Explorer"
          image="/images/cards/pubky-explorer.png"
          links={[
            { label: "Explore", href: "https://explorer.pubky.app", external: true },
            { label: "Learn More", href: "/explore/technologies/pubky-explorer/" },
          ]}
        />
      </div>
    </section>

    <section id="for-developers" class="home-section">
      <h2 class="home-section-title">
        <a class="home-section-title-link" href="#for-developers">For Developers</a>
      </h2>
      <div class="card-grid card-grid-3">
        <ImageCard
          title="Pubky Core"
          titleIcon={pubkyBrandWhite}
          image="/images/cards/pubky-core.png"
          tags={[
            { label: "SDK", href: "/explore/pubkycore/sdk/" },
            { label: "API", href: "/explore/pubkycore/api/" },
            { label: "Homeserver", href: "/explore/pubkycore/homeserver/" },
          ]}
        />
        <ImageCard
          title="Developer Tools"
          image="/images/cards/developer-tools.png"
          tags={[
            { label: "Docker Stack", href: "/explore/technologies/pubky-docker/" },
            { label: "CLI", href: "/explore/technologies/pubky-cli/" },
            { label: "Explorer", href: "/explore/technologies/pubky-explorer/" },
            { label: "PKDNS", href: "/explore/technologies/pkdns/" },
          ]}
        />
        <ImageCard
          title="Pubky Apps"
          image="/images/cards/pubky-apps.png"
          tags={[
            { label: "Architecture", href: "/explore/pubky-apps/app-architectures/introduction/" },
            { label: "Indexing", href: "/explore/pubky-apps/indexing-and-aggregation/introduction/" },
            { label: "Reference App", href: "/explore/pubky-apps/reference-app/introduction/" },
          ]}
        />
      </div>
    </section>
  </div>

  <!-- Key Concepts -->
  <section id="key-concepts" class="home-section key-concepts">
    <h2 class="home-section-title">
      <a class="home-section-title-link" href="#key-concepts">Key Concepts</a>
    </h2>
    <div class="card-grid card-grid-4">
      <TextCard
        title="PKARR"
        description="Public key addressable resource records for decentralized identity."
        href="/explore/pubkycore/pkarr/introduction/"
        icon={icons.fingerprint}
      />
      <TextCard
        title="Censorship Resistance"
        description="Why centralized platforms fail and how Pubky solves it."
        href="/explore/concepts/censorship/"
        icon={icons.shieldOff}
      />
      <TextCard
        title="Credible Exit"
        description="Freedom to switch providers without losing data."
        href="/explore/concepts/credible-exit/"
        icon={icons.arrowLeftRight}
      />
      <TextCard
        title="Semantic Social Graph"
        description="Tagged relationships and user-controlled filtering."
        href="/explore/concepts/semantic-social-graph/"
        icon={icons.lineChart}
      />
    </div>
  </section>

  <!-- Demos — Figma node 34702:87731 -->
  <section id="demos" class="home-section demos">
    <div class="demos-header">
      <h2 class="home-section-title">
        <a class="home-section-title-link" href="#demos">Demos</a>
      </h2>
      <p class="demos-subtitle">Try some proof of concepts built on Pubky Core. What will you create?</p>
    </div>
    <div class="card-grid card-grid-4 demos-grid">
      {demos.map((demo) => (
        <DemoCard title={demo.title} description={demo.description} actions={demo.actions} />
      ))}
    </div>
  </section>

  <!-- Figma: Join our Community (node 34690:85373) — two-column 50/50 with 48px gap.
       Left column = centered title + arrow line. Right column = 4 link rows separated by hairlines. -->
  <section id="community" class="home-section community-section">
    <div class="community-title-col">
      <h2 class="community-title">
        <a class="home-section-title-link" href="#community">Join our Community</a>
      </h2>
      {/* Figma: 304px arrow line below title (Vector 21 in node 34690:87121) */}
      <svg class="community-title-arrow" width="304" height="22" viewBox="0 0 304 22" fill="none" aria-hidden="true">
        <path d="M0 11H302M302 11L292 1M302 11L292 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <ul class="community-links">
      <li>
        <a href="https://pubky.app" target="_blank" rel="noopener noreferrer" class="community-link" aria-label="Join Pubky.app (opens in new tab)">
          <span class="community-link-title">Join Pubky.app</span>
          <span class="community-link-tail">
            <span class="community-link-desc">Try the decentralized social media app.</span>
            <span class="community-link-arrow" aria-hidden="true">
              <img src={withBase('/images/icons/arrow-right.svg')} alt="" width="20" height="20" />
            </span>
          </span>
        </a>
      </li>
      <li>
        <a href="https://t.me/pubkycore" target="_blank" rel="noopener noreferrer" class="community-link" aria-label="Telegram (opens in new tab)">
          <span class="community-link-title">Telegram</span>
          <span class="community-link-tail">
            <span class="community-link-desc">Join the community chat.</span>
            <span class="community-link-arrow" aria-hidden="true">
              <img src={withBase('/images/icons/arrow-right.svg')} alt="" width="20" height="20" />
            </span>
          </span>
        </a>
      </li>
      <li>
        <a href="https://github.com/pubky" target="_blank" rel="noopener noreferrer" class="community-link" aria-label="GitHub (opens in new tab)">
          <span class="community-link-title">GitHub</span>
          <span class="community-link-tail">
            <span class="community-link-desc">Source code and repositories.</span>
            <span class="community-link-arrow" aria-hidden="true">
              <img src={withBase('/images/icons/arrow-right.svg')} alt="" width="20" height="20" />
            </span>
          </span>
        </a>
      </li>
      <li>
        <a href={withBase('/contributing/')} class="community-link">
          <span class="community-link-title">Contributing</span>
          <span class="community-link-tail">
            <span class="community-link-desc">How to contribute to Pubky.</span>
            <span class="community-link-arrow" aria-hidden="true">
              <img src={withBase('/images/icons/arrow-right.svg')} alt="" width="20" height="20" />
            </span>
          </span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Figma: Brand endorsement — gap 10px, two linked elements -->
  <div class="home-footer">
    <div class="home-footer-brand">
      <a href="https://synonym.to" target="_blank" rel="noopener noreferrer" class="home-footer-link" aria-label="Synonym (opens in new tab)">
        <img src={withBase('/images/synonym-logo.svg')} alt="Synonym" height="24" />
      </a>
      <a href="https://tether.io" target="_blank" rel="noopener noreferrer" class="home-footer-link" aria-label="Tether (opens in new tab)">
        <img src={withBase('/images/tether-company.svg')} alt="a tether. company" height="16" />
      </a>
    </div>
  </div>
</div>

<style is:global>
  .home-content {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-16);
    padding-bottom: var(--spacing-10);
    /* Break out of starlight container */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
  }

  /* Figma: 1280px container with 40px padding = 1200px content area (same as header/hero) */
  .home-section {
    max-width: 1280px;
    padding: 0 var(--spacing-10);
    box-sizing: border-box;
    width: 100%;
    scroll-margin-top: calc(var(--sl-nav-height) - var(--spacing-6));
  }

  /* Figma: Quick Start box = bg alpha/white 4.5%, radius rounded-lg(12), p spacing-8(32) */
  .home-section-box {
    border-radius: var(--radius-lg);
  }

  /* Figma: section H1 = Inter Tight Bold, text-5xl (48/48). Quick Start is the
     only exception at text-4xl (36/1) — apply .home-section-title-sm there. */
  .home-section-title {
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-5xl-size);
    font-weight: 700;
    line-height: var(--text-5xl-lh);
    color: var(--base-foreground);
    margin: 0 0 var(--spacing-8) 0;
  }

  .home-section-title-sm {
    font-size: var(--text-4xl-size);
    line-height: 1;
  }

  .home-section-title-link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  /* Wrapper for Users + Developers — vertical stack with the same gap as other sections.
     Sections size to their own content; cards within each row still equalize via grid. */
  .image-card-sections {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    max-width: 1280px;
    padding: 0 var(--spacing-10);
    box-sizing: border-box;
    width: 100%;
  }

  /* Sections inside the wrapper inherit spacing from the wrapper */
  .image-card-sections .home-section {
    max-width: none;
    padding: 0;
  }

  .card-grid {
    display: grid;
    gap: var(--spacing-6);
  }

  .card-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .card-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Figma: Key Concepts (node 34690:87147) — section title centered, sized text-5xl
     (48/48 bold) unlike other section titles which are text-4xl(36). Cards rendered
     as transparent text blocks with no card background or border (Pubky / Text block). */
  .key-concepts .home-section-title {
    font-size: var(--text-5xl-size);
    line-height: var(--text-5xl-lh);
    text-align: center;
  }

  .key-concepts .text-card {
    background: transparent;
    border-color: transparent;
  }

  .key-concepts .text-card:hover {
    background: transparent;
    border-color: transparent;
  }

  /* Figma: Pubky / Text block arrow row (node 34702:87308) is items-start with no
     justify-end — the arrow sits at the left edge of the row, not the right like the
     default TextCard. */
  .key-concepts .text-card-arrow {
    justify-content: flex-start;
    padding-right: 0;
  }

  /* Figma: Demos (node 34702:87731) — Frame 48095428 = flex-col gap spacing-6(24)
     between title row and subtitle, then spacing-10(40) before the tiles grid. */
  .demos {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
  }

  .demos-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .demos-header .home-section-title {
    margin: 0;
  }

  /* Figma: Website/h4 = Inter Tight SemiBold 35/44, tracking -0.3px, alpha-white 50%.
     35px / 44px / -0.3px are hardcoded — Website/h4 typography, off our text scale */
  .demos-subtitle {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: 35px;
    line-height: 44px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Figma: Tiles = flex-wrap with gap 24px; 4 columns at 1280 (282px each) */
  .demos-grid {
    grid-auto-rows: 1fr;
  }

  /* Figma: Community (node 34690:85373) — 2-col grid, gap spacing-12(48px). Grid (vs flex)
     guarantees the two columns are exactly equal width regardless of the title col's px-12
     padding (a flex:1 basis:0 + padding combo widens the padded column by ~48px). */
  .community-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--spacing-12);
  }

  /* Figma: Title col (node 34690:85374) — flex-col, gap spacing-6(24), px spacing-12(48), centered */
  .community-title-col {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-6);
    padding: 0 var(--spacing-12);
    min-width: 0;
  }

  /* Figma: Community title = Inter Tight Bold text-5xl(48/48), same tier as Key Concepts. */
  .community-title {
    margin: 0;
    font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    font-size: var(--text-5xl-size);
    line-height: var(--text-5xl-lh);
    font-weight: 700;
    color: var(--base-foreground);
    text-align: center;
  }

  .community-title-arrow {
    color: var(--base-foreground);
    flex-shrink: 0;
  }

  /* Figma: Frame 2 (node 34690:87065) — flex-col gap spacing-5(20), 4 link rows
     with 1px hairline separators between them. */
  .community-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .community-links li {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .community-links li + li::before {
    content: "";
    display: block;
    height: 1px;
    background: var(--base-border);
  }

  /* Figma: Social media link row — flex, gap spacing-4(16), items-center.
     Title H2 (text-3xl 30/36 bold), description text-base muted, arrow button right-aligned. */
  .community-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .community-link-title {
    font-size: var(--text-3xl-size);
    line-height: var(--text-3xl-lh);
    font-weight: 700;
    color: var(--base-foreground);
    white-space: nowrap;
    /* Figma: title row has pb spacing-2(8) inside an items-center flex —
       reproduces the visual baseline shift between 30px title and 16px description */
    padding-bottom: var(--spacing-2);
  }

  /* Figma: Flex wrapper (description + ghost button) sits 16px after the title with
     0 gap inside, so the arrow appears immediately after the description on hover. */
  .community-link-tail {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .community-link-desc {
    font-size: var(--text-base-size);
    line-height: var(--text-base-lh);
    font-weight: 500;
    color: var(--base-muted-foreground);
    white-space: nowrap;
  }

  /* Figma: Ghost icon button (Variant=Ghost, State=Default, Size=icon, node 46:195)
     — 36x36, p spacing-1(4), radius full, transparent bg. Sits right after description. */
  .community-link-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: var(--spacing-1);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  /* Figma default state shows no arrow — icon fades in on row hover only,
     no background change on the pill. */
  .community-link-arrow img {
    width: 20px;
    height: 20px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .community-link:hover .community-link-arrow img {
    opacity: 1;
  }

  .home-footer {
    max-width: 1280px;
    padding: var(--spacing-4) var(--spacing-10) 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* Figma: Brand endorsement = flex, gap 10px, items-center.
     10px is hardcoded — doesn't fit the 4px spacing scale */
  .home-footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Not in Figma — added for smooth hover feedback */
  .home-footer-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .home-footer-link:hover {
    opacity: 0.7;
  }

  .home-footer-link img {
    height: auto;
    width: auto;
  }

  /* 1049px breakpoint — container layout switches to match header/install-section mobile */
  @media (max-width: 1049px) {
    .home-content {
      width: auto;
      margin-left: 0;
      padding: 0 0 var(--spacing-8);
      gap: var(--spacing-20);
    }

    .home-section {
      padding: 0;
    }

    .home-section-box {
      padding: 0;
      border-radius: 0;
    }

    .image-card-sections {
      padding: 0;
