---
/**
 * Custom social icons matching Figma design.
 * Icons are exported directly from Figma as SVGs (outlined/stroke style).
 * Order: GitHub, YouTube, X, Telegram — matching Figma header layout.
 */
import config from 'virtual:starlight/user-config';
import { withBase } from '../utils/base-path';

const links = config.social || [];

/* Map Starlight icon names to Figma-exported SVG paths */
const iconFiles: Record<string, string> = {
  github: withBase('/images/icons/github.svg'),
  youtube: withBase('/images/icons/youtube.svg'),
  'x.com': withBase('/images/icons/x.svg'),
  telegram: withBase('/images/icons/telegram.svg'),
};
---

{links.length > 0 && (
  <>
    {links.map(({ label, href, icon }) => (
      <a {href} rel="me noopener noreferrer" target="_blank" class="sl-flex social-icon-link" aria-label={`${label} (opens in new tab)`}>
        <span class="sr-only">{label}</span>
        <img
          src={iconFiles[icon] || iconFiles.github}
          alt=""
          aria-hidden="true"
          width="24"
          height="24"
          class="social-icon-img"
        />
      </a>
    ))}
  </>
)}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      opacity: 0.66;
    }
    .social-icon-img {
      width: 24px;
      height: 24px;
    }
  }
</style>
