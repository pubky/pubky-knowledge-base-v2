---
interface Props {
  title: string;
  titleIcon?: string;
  description: string;
  image: string;
  tags?: { label: string; href: string }[];
  links?: { label: string; href: string; external?: boolean }[];
}

const { title, titleIcon, description, image, tags = [], links = [] } = Astro.props;
---

<div class="image-card">
  <div class="image-card-thumbnail">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="image-card-content">
    <h3 class="image-card-title">
      {titleIcon && <span class="image-card-title-icon" set:html={titleIcon} />}
      {title}
    </h3>
    <p class="image-card-description">{description}</p>
    {tags.length > 0 && (
      <div class="image-card-tags">
        {tags.map((tag) => (
          <a href={tag.href} class="image-card-tag">{tag.label}</a>
        ))}
      </div>
    )}
    {links.length > 0 && (
      <div class="image-card-links">
        {links.map((link) => (
          <a
            href={link.href}
            class="image-card-link"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style is:global>
  /* Figma: Pubky / Cards / Image (node 32394:120859) */
  .image-card {
    display: flex;
    flex-direction: column;
    /* Figma: gap = spacing/4 (16px) */
    gap: var(--spacing-4);
    /* Figma: padding = spacing/5 (20px) */
    padding: var(--spacing-5);
    background: var(--base-background);
    /* Figma: border = 1px base/border */
    border: 1px solid var(--base-border);
    /* Figma: border-radius = rounded-lg (12px) */
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  .image-card:hover {
    border-color: var(--sl-color-gray-3);
    box-shadow: 0 4px 24px rgba(255, 255, 255, 0.04),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  /* Figma: Thumbnail = black bg, rounded-lg, aspect 352/187 */
  .image-card-thumbnail {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 352 / 187;
    background: var(--base-background);
    flex-shrink: 0;
  }

  .image-card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-card-content {
    display: flex;
    flex-direction: column;
    /* Figma: gap = spacing/2 (8px) */
    gap: var(--spacing-2);
    flex: 1;
  }

  /* Figma: Logos flex row, gap spacing/2, items-center */
  .image-card-title {
    margin: 0;
    font-size: var(--text-lg-size);
    font-weight: 600;
    color: var(--base-foreground);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .image-card-title-icon {
    display: inline-flex;
    color: var(--base-foreground);
    flex-shrink: 0;
  }

  /* Figma: Typography / P = text-base (16px), line-height 24px, muted-foreground, medium */
  .image-card-description {
    margin: 0;
    font-size: var(--text-base-size);
    line-height: var(--text-base-lh);
    color: var(--base-muted-foreground);
    font-weight: 500;
    flex: 1;
    min-height: 1px;
  }

  .image-card-tags {
    display: flex;
    flex-wrap: wrap;
    /* Figma: gap = 8px */
    gap: var(--spacing-2);
    margin-top: auto;
  }

  /* Figma: tag pill = h-40, rounded-full, text-sm bold, shadow-xs */
  .image-card-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Figma: h = 40px, px = spacing/4 (16px), py = 10px */
    height: 40px;
    padding: 0 var(--spacing-4);
    background: var(--alpha-white-5);
    border: 1px solid var(--base-border);
    border-radius: var(--radius-full);
    color: var(--base-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .image-card-tag:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--sl-color-gray-4);
  }

  /* Figma: Flex row, flex-wrap, gap 8px */
  .image-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: auto;
  }

  /* Figma: Button outline variant = h-40, rounded-full, text-sm bold, shadow-xs */
  .image-card-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Figma: h = 40px, px = spacing/4 (16px) */
    height: 40px;
    padding: 0 var(--spacing-4);
    background: var(--alpha-white-5);
    border: 1px solid var(--base-border);
    border-radius: var(--radius-full);
    color: var(--base-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .image-card-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--sl-color-gray-4);
  }

  /* Figma: Button secondary variant = bg base/secondary, color secondary-foreground, no border */
  .image-card-link:not(:first-child) {
    background: var(--base-secondary);
    border-color: transparent;
    color: var(--base-secondary-foreground);
  }

  .image-card-link:not(:first-child):hover {
    background: #3a3a3f;
    border-color: transparent;
  }
</style>
