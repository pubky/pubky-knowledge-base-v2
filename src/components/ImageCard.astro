---
interface Props {
  title: string;
  titleIcon?: string;
  description: string;
  image: string;
  tags?: { label: string; href: string }[];
  links?: { label: string; href: string; external?: boolean }[];
}

const { title, titleIcon, description, image, tags = [], links = [] } = Astro.props;
---

<div class="image-card">
  <div class="image-card-thumbnail">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="image-card-content">
    <h3 class="image-card-title">
      {titleIcon && <span class="image-card-title-icon" set:html={titleIcon} />}
      {title}
    </h3>
    <p class="image-card-description">{description}</p>
    {tags.length > 0 && (
      <div class="image-card-tags">
        {tags.map((tag) => (
          <a href={tag.href} class="image-card-tag">{tag.label}</a>
        ))}
      </div>
    )}
    {links.length > 0 && (
      <div class="image-card-links">
        {links.map((link) => (
          <a
            href={link.href}
            class="image-card-link"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            aria-label={link.external ? `${link.label} (opens in new tab)` : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style is:global>
  .image-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    transition: border-color 0.2s ease;
    overflow: hidden;
  }

  .image-card:hover {
    border-color: var(--sl-color-gray-4);
  }

  .image-card-thumbnail {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 352 / 187;
    background: var(--sl-color-black);
    flex-shrink: 0;
  }

  .image-card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .image-card-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .image-card-title-icon {
    display: inline-flex;
    color: var(--sl-color-white);
    flex-shrink: 0;
  }

  .image-card-description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  .image-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .image-card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .image-card-tag:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--sl-color-gray-4);
  }

  .image-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .image-card-link {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .image-card-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--sl-color-gray-4);
  }
</style>
