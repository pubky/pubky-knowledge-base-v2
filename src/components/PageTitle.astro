---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { docsMarkdownPath, withBase } from '../utils/base-path';

const { id } = Astro.locals.starlightRoute;
const markdownPath = id === '404' ? null : docsMarkdownPath(Astro.url.pathname);
---

<div class="doc-title not-content">
  <div class="doc-title-row">
    <Default />
    {markdownPath && (
      <div class="doc-title-tools" data-pagefind-ignore>
        <div class="markdown-actions" role="group" aria-label="Markdown for this page">
          <a href={markdownPath} target="_blank" rel="noopener noreferrer" aria-label="View Markdown for this page (opens in new tab)" title="View Markdown (opens in new tab)">
            <img src={withBase('/images/icons/file.svg')} width="16" height="16" alt="" aria-hidden="true" />
            <span>Markdown</span>
          </a>
          <button type="button" data-markdown-copy={markdownPath} aria-label="Copy link to this page’s Markdown" title="Copy Markdown link" hidden>
            <img src={withBase('/images/icons/line-copy.svg')} width="16" height="16" alt="" aria-hidden="true" />
            <span data-copy-label>Copy link</span>
          </button>
        </div>
      </div>
    )}
  </div>
  {markdownPath && (
    <p class="markdown-copy-status" role="status" aria-live="polite" aria-atomic="true" data-pagefind-ignore></p>
  )}
</div>

<script>
  import { enhanceClipboardButton } from '../scripts/clipboard';

  function enhanceMarkdownActions() {
    document.querySelectorAll<HTMLButtonElement>('[data-markdown-copy]').forEach((button) => {
      const status = button.closest('.doc-title')?.querySelector<HTMLElement>('[role="status"]');
      const markdownPath = button.dataset.markdownCopy;
      if (!status || !markdownPath) return;

      enhanceClipboardButton(button, {
        text: () => new URL(markdownPath, window.location.origin).href,
        status,
        successMessage: 'Markdown link copied.',
        failureMessage: 'Couldn’t copy. Open Markdown and copy the address.',
        successAriaLabel: 'Copied Markdown link',
      });
    });
  }
  enhanceMarkdownActions();
</script>

<style>
  /* Page utilities follow the existing Pubky spacing, palette, and controls. */
  .doc-title { container: doc-title / inline-size; }
  .doc-title-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding-top: var(--spacing-4);
  }
  .doc-title-row :global(h1) {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-size: var(--text-4xl-size);
    line-height: var(--text-4xl-lh);
    white-space: nowrap;
  }
  .doc-title-tools { flex: 0 0 auto; }
  .markdown-actions {
    display: inline-flex;
    align-items: stretch;
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-full);
    background: var(--alpha-white-5);
  }
  .markdown-actions a, .markdown-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    min-width: var(--landing-touch-target);
    min-height: var(--landing-touch-target);
    padding: var(--spacing-2) var(--spacing-4);
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--base-secondary-foreground);
    font: inherit;
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--landing-motion) ease, color var(--landing-motion) ease;
  }
  .markdown-actions button {
    border-left: var(--landing-border-width) solid var(--base-border);
    border-start-start-radius: 0;
    border-end-start-radius: 0;
  }
  .markdown-actions a:has(+ button:not([hidden])) {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }
  .markdown-actions a:hover, .markdown-actions button:hover {
    background: var(--base-secondary);
    color: var(--base-foreground);
  }
  .markdown-actions img { flex-shrink: 0; }
  .markdown-actions [data-copy-label] { min-width: 8ch; }
  .markdown-actions button[hidden] { display: none; }
  .markdown-actions button:disabled { cursor: wait; }
  .markdown-copy-status {
    max-width: 30ch;
    margin: 0;
    margin-left: auto;
    color: var(--base-secondary-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
  }
  .markdown-copy-status:not(:empty) { margin-top: var(--spacing-2); }
  @container doc-title (max-width: 44rem) {
    .doc-title-row { gap: var(--spacing-2); }
    .doc-title-row :global(h1) {
      font-size: var(--text-3xl-size);
      line-height: var(--text-3xl-lh);
    }
    .markdown-actions a, .markdown-actions button {
      width: var(--landing-touch-target);
      padding: var(--spacing-2);
    }
    .markdown-actions span { display: none; }
  }
  @container doc-title (max-width: 28rem) {
    .doc-title-row :global(h1) {
      font-size: var(--text-2xl-size);
      line-height: var(--text-2xl-lh);
    }
  }
  @container doc-title (max-width: 24rem) {
    .doc-title-row :global(h1) {
      font-size: var(--text-lg-size);
      line-height: var(--text-lg-lh);
    }
  }
  @container doc-title (max-width: 20rem) {
    .doc-title-row :global(h1) {
      font-size: var(--text-base-size);
      line-height: var(--text-base-lh);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .markdown-actions a, .markdown-actions button { transition: none; }
  }
  @media print {
    .doc-title-tools, .markdown-copy-status { display: none; }
  }
</style>
