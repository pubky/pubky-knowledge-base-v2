<script>
  type CodeLanguage = "javascript" | "react-native" | "rust";
  type ViewportAnchor = {
    element: HTMLElement;
    top: number;
  };

  const storageKey = "pubky-code-language";
  const languageParameter = "lang";
  let pendingViewportAnchor: ViewportAnchor | null = null;
  let pendingViewportFrame: number | null = null;

  function isCodeLanguage(language: string | undefined | null): language is CodeLanguage {
    return language === "javascript" || language === "react-native" || language === "rust";
  }

  function getSavedLanguage(): CodeLanguage | null {
    try {
      const language = sessionStorage.getItem(storageKey);
      return isCodeLanguage(language) ? language : null;
    } catch {
      return null;
    }
  }

  function getUrlLanguage(): CodeLanguage | null {
    const language = new URL(window.location.href).searchParams.get(languageParameter);
    return isCodeLanguage(language) ? language : null;
  }

  function saveLanguage(language: CodeLanguage): void {
    try {
      sessionStorage.setItem(storageKey, language);
    } catch {
      // The switcher still works when storage is unavailable.
    }
  }

  function writeUrlLanguage(language: CodeLanguage): void {
    const url = new URL(window.location.href);
    if (url.searchParams.get(languageParameter) === language) return;

    url.searchParams.set(languageParameter, language);
    window.history.replaceState(window.history.state, "", url);
  }

  function restoreViewportAnchor(): void {
    const anchor = pendingViewportAnchor;
    pendingViewportAnchor = null;
    pendingViewportFrame = null;

    if (!anchor?.element.isConnected) return;

    const offset = anchor.element.getBoundingClientRect().top - anchor.top;
    if (offset !== 0) {
      window.scrollBy({ top: offset, left: 0, behavior: "auto" });
    }
  }

  function scheduleViewportAnchor(element: HTMLElement, top: number): void {
    pendingViewportAnchor = { element, top };
    pendingViewportFrame = requestAnimationFrame(restoreViewportAnchor);
  }

  function selectLanguage(
    language: CodeLanguage,
    persist = true,
    anchor?: HTMLElement,
  ): void {
    if (pendingViewportFrame !== null) {
      cancelAnimationFrame(pendingViewportFrame);
      restoreViewportAnchor();
    }

    const anchorTop = anchor?.getBoundingClientRect().top;

    document.querySelectorAll<HTMLElement>(".language-code-group").forEach((block) => {
      const tabs = block.querySelectorAll<HTMLButtonElement>(".tab");
      const commands = block.querySelectorAll<HTMLElement>(".command");
      const selectedLanguage = Array.from(commands).some(
        (command) => command.dataset.index === language,
      )
        ? language
        : "javascript";

      tabs.forEach((tab) => {
        const selected = tab.dataset.index === selectedLanguage;
        tab.classList.toggle("active", selected);
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });

      commands.forEach((command) => {
        const selected = command.dataset.index === selectedLanguage;
        command.classList.toggle("active", selected);
        command.hidden = !selected;
      });
    });

    if (anchor && anchorTop !== undefined) scheduleViewportAnchor(anchor, anchorTop);
    if (persist) {
      saveLanguage(language);
      writeUrlLanguage(language);
    }
  }

  function bindLanguageBlock(block: HTMLElement): void {
    if (block.dataset.codeLanguageReady === "true") return;
    block.dataset.codeLanguageReady = "true";

    const tabs = Array.from(block.querySelectorAll<HTMLButtonElement>(".tab"));
    tabs.forEach((tab, tabIndex) => {
      tab.addEventListener("click", () => {
        const language = tab.dataset.index;
        if (isCodeLanguage(language)) selectLanguage(language, true, block);
      });

      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;

        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : event.key === "ArrowLeft"
                ? (tabIndex - 1 + tabs.length) % tabs.length
                : (tabIndex + 1) % tabs.length;
        const nextTab = tabs[nextIndex];
        const language = nextTab?.dataset.index;
        if (!nextTab || !isCodeLanguage(language)) return;

        selectLanguage(language, true, block);
        nextTab.focus({ preventScroll: true });
      });
    });
  }

  function setupLanguageCodeSwitchers(): void {
    const blocks = document.querySelectorAll<HTMLElement>(".language-code-group");
    blocks.forEach(bindLanguageBlock);

    if (blocks.length > 0) {
      const language = getUrlLanguage() ?? getSavedLanguage() ?? "javascript";
      selectLanguage(language, false);
      saveLanguage(language);
      writeUrlLanguage(language);
    }
  }

  function syncLanguageFromUrl(): void {
    const blocks = document.querySelectorAll<HTMLElement>(".language-code-group");
    if (blocks.length === 0) return;

    const language = getUrlLanguage() ?? "javascript";
    selectLanguage(language, false);
    saveLanguage(language);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLanguageCodeSwitchers, { once: true });
  } else {
    setupLanguageCodeSwitchers();
  }
  document.addEventListener("astro:page-load", setupLanguageCodeSwitchers);
  window.addEventListener("popstate", syncLanguageFromUrl);
</script>
