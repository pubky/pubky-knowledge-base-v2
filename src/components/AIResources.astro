---
import { withBase } from '../utils/base-path';
---

<section id="build-with-ai" class="home-section ai-resources" aria-labelledby="ai-resources-title">
  <div class="ai-resources-heading">
    <h2 id="ai-resources-title">Build with AI</h2>
    <p>Choose the context your next step needs.</p>
  </div>

  <div class="ai-resource-grid">
    <article class="ai-resource">
      <div class="ai-resource-provider">
        <img src={withBase('/images/icons/code-xml.svg')} width="20" height="20" alt="" aria-hidden="true" />
        Pubky agent skills
      </div>
      <h3>Add Pubky skills</h3>
      <p>Give your coding agent focused Pubky workflows. Check the skills’ references against your SDK version.</p>
      <div class="ai-resource-links">
        <a href="https://github.com/pubky/agent-skills" target="_blank" rel="noopener noreferrer" aria-label="Review Pubky agent skills on GitHub (opens in new tab)">
          Review the skills <img class="ai-resource-arrow" src={withBase('/images/icons/arrow-right.svg')} width="16" height="16" alt="" aria-hidden="true" />
        </a>
      </div>
    </article>

    <article class="ai-resource">
      <div class="ai-resource-provider">
        <img src={withBase('/images/icons/file.svg')} width="20" height="20" alt="" aria-hidden="true" />
        Context7
      </div>
      <h3>Find API context</h3>
      <p>Bring library docs into your assistant with Context7’s third-party index. Check the available version against your project.</p>
      <div class="ai-resource-links">
        <a href="https://context7.com/pubky/pubky-homeserver" target="_blank" rel="noopener noreferrer" aria-label="Pubky homeserver documentation on Context7 (opens in new tab)">
          Homeserver <img class="ai-resource-arrow" src={withBase('/images/icons/arrow-right.svg')} width="16" height="16" alt="" aria-hidden="true" />
        </a>
        <a href="https://context7.com/pubky/pkarr" target="_blank" rel="noopener noreferrer" aria-label="PKARR documentation on Context7 (opens in new tab)">
          PKARR <img class="ai-resource-arrow" src={withBase('/images/icons/arrow-right.svg')} width="16" height="16" alt="" aria-hidden="true" />
        </a>
      </div>
    </article>

    <article class="ai-resource">
      <div class="ai-resource-provider">
        <img src={withBase('/images/icons/circle-help.svg')} width="20" height="20" alt="" aria-hidden="true" />
        DeepWiki
      </div>
      <h3>Understand the code</h3>
      <p>Explore the homeserver and ask questions in DeepWiki. Verify its AI-generated explanations against the linked source.</p>
      <div class="ai-resource-links">
        <a href="https://deepwiki.com/pubky/pubky-homeserver" target="_blank" rel="noopener noreferrer" aria-label="Explore the Pubky homeserver on DeepWiki (opens in new tab)">
          Explore the codebase <img class="ai-resource-arrow" src={withBase('/images/icons/arrow-right.svg')} width="16" height="16" alt="" aria-hidden="true" />
        </a>
      </div>
    </article>
  </div>

  <div class="direct-docs">
    <div>
      <h3>Direct docs for any agent</h3>
      <p>Start small. Fetch individual pages as you need them.</p>
    </div>
    <nav class="direct-docs-links" aria-label="Machine-readable Pubky documentation">
      <a href={withBase('/llms.txt')}><span>llms.txt</span><span class="direct-docs-format">Index</span></a>
      <a href={withBase('/llms-small.txt')}><span>llms-small.txt</span><span class="direct-docs-format">Compact index</span></a>
      <a href={withBase('/llms-full.txt')}><span>llms-full.txt</span><span class="direct-docs-format">Full bundle</span></a>
      <a href={withBase('/explore/pubky-protocol/getting-started.md')}><span>Per-page .md</span><span class="direct-docs-format">Developer guide</span></a>
    </nav>
  </div>
</section>

<style>
  /* Original resource section, using the shared Pubky spacing and type scale. */
  .ai-resources {
    scroll-margin-top: calc(var(--sl-nav-height) + var(--spacing-6));
  }
  .ai-resources-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-8);
  }
  .ai-resources-heading h2 {
    margin: 0;
    color: var(--base-foreground);
    font-family: 'Inter Tight', var(--sl-font);
    font-size: var(--text-4xl-size);
    line-height: var(--text-4xl-lh);
    font-weight: 700;
    letter-spacing: var(--landing-heading-tracking);
  }
  .ai-resources-heading p {
    margin: 0;
    font-size: var(--text-base-size);
    line-height: var(--text-base-lh);
    color: var(--base-muted-foreground);
  }
  .ai-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--spacing-8);
  }
  .ai-resource {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    border-top: var(--landing-border-width) solid var(--base-border);
    padding-top: var(--spacing-6);
  }
  .ai-resource-provider {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    color: var(--base-muted-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
  }
  .ai-resource h3 {
    margin: var(--spacing-4) 0 var(--spacing-2);
    color: var(--base-foreground);
    font-family: 'Inter Tight', var(--sl-font);
    font-size: var(--text-2xl-size);
    line-height: var(--text-2xl-lh);
    font-weight: 600;
  }
  .ai-resource p {
    margin: 0 0 var(--spacing-4);
    color: var(--base-secondary-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-base-lh);
  }
  .ai-resource-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-6);
    margin-top: auto;
  }
  .ai-resource-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: var(--landing-touch-target);
    color: var(--base-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--landing-motion) ease;
  }
  .ai-resource-arrow {
    transform: rotate(-45deg);
    transition: transform var(--landing-motion) ease;
  }
  .ai-resource-links a:hover { color: var(--brand-lime); }
  .ai-resource-links a:hover .ai-resource-arrow { transform: translate(var(--spacing-1), calc(-1 * var(--spacing-1))) rotate(-45deg); }
  .direct-docs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-6);
    margin-top: var(--spacing-8);
    padding: var(--spacing-5) var(--spacing-6);
    border: var(--landing-border-width) solid var(--base-border);
    border-radius: var(--radius-lg);
    background: var(--alpha-white-5);
  }
  .direct-docs h3 {
    margin: 0 0 var(--spacing-1);
    color: var(--base-secondary-foreground);
    font-size: var(--text-sm-size);
    line-height: var(--text-sm-lh);
    font-weight: 600;
  }
  .direct-docs p {
    margin: 0;
    color: var(--base-muted-foreground);
    font-size: var(--text-xs-size);
    line-height: var(--text-sm-lh);
  }
  .direct-docs-links {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-6);
  }
  .direct-docs-links a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacing-1);
    min-height: var(--landing-touch-target);
    min-width: var(--landing-touch-target);
    color: var(--base-secondary-foreground);
    font-family: var(--sl-font-mono);
    font-size: var(--text-xs-size);
    line-height: var(--text-xs-lh);
    text-decoration: none;
    transition: color var(--landing-motion) ease;
  }
  .direct-docs-format {
    font-family: var(--sl-font);
    color: var(--base-muted-foreground);
  }
  .direct-docs-links a:hover { color: var(--brand-lime); }

  @media (max-width: 1049px) {
    .ai-resource-grid { gap: var(--spacing-6); }
    .direct-docs { flex-direction: column; align-items: stretch; }
    .direct-docs-links { justify-content: space-between; }
  }
  @media (max-width: 767px) {
    .ai-resources-heading { flex-direction: column; align-items: stretch; gap: var(--spacing-2); }
    .ai-resource-grid { display: grid; grid-template-columns: minmax(0, 1fr); align-items: stretch; }
    .ai-resource { padding-top: var(--spacing-5); }
    .ai-resource h3 { margin-top: var(--spacing-3); }
    .ai-resource p { margin-bottom: var(--spacing-2); }
    .direct-docs { padding: var(--spacing-5); }
    .direct-docs-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; }
  }
</style>
